{
  "name": "budgetwheel",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:android": "tsc && vite build --mode android --outDir android/app/src/main/assets --emptyOutDir",
    "bundle:android": "npm run build:android && cd android && gradlew.bat bundleRelease",
    "test:calendar": "node --experimental-strip-types scripts/calendar-check.ts",
    "test:tour": "node scripts/smoke-tour.mjs",
    "preview": "vite preview --host --port=4173"
  },
  "devDependencies": {
    "puppeteer-core": "^25.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
