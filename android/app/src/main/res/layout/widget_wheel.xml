<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="16dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_open_app"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_open_app"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/widget_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:text="@string/widget_name"
                android:textAllCaps="true"
                android:textColor="@color/bw_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/bw_on"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_chart_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_cycle_bg"
            android:contentDescription="@string/widget_graph"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_graph" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_graph_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_bar_card"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_graph_swatch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_graph_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/bw_on"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_graph_share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/bw_soft"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_graph_oob_head"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="72dp"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_graph_oob_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_stat_oob"
                    android:textAllCaps="false"
                    android:textColor="@color/bw_soft"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_graph_oob_head_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/bw_on"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_graph_income"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_graph_income_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bw_on"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.05"
                    android:text="@string/widget_stat_income"
                    android:textAllCaps="true"
                    android:textColor="@color/bw_soft"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_stat_budgeted_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_graph_stat"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/widget_stat_budgeted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/bw_on"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_stat_budgeted_lbl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.03"
                    android:maxLines="2"
                    android:text="@string/widget_stat_budgeted"
                    android:textAllCaps="true"
                    android:textColor="@color/bw_soft"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_stat_spent_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_graph_stat"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/widget_stat_spent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/bw_on"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_stat_spent_lbl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.03"
                    android:maxLines="2"
                    android:text="@string/widget_stat_spent"
                    android:textAllCaps="true"
                    android:textColor="@color/bw_soft"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_stat_left_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_graph_stat"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/widget_stat_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/bw_on"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_stat_left_lbl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.03"
                    android:maxLines="2"
                    android:text="@string/widget_stat_left"
                    android:textAllCaps="true"
                    android:textColor="@color/bw_soft"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_wheel_wrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/widget_wheel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_name"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/widget_wheel_corner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_graph_stat"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_wheel_oob_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/bw_on"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_wheel_oob_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:text="@string/widget_stat_oob"
                android:textAllCaps="true"
                android:textColor="@color/bw_soft"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_wheel_left_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_graph_stat"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_wheel_left_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/bw_on"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_wheel_left_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:text="@string/widget_stat_left"
                android:textAllCaps="true"
                android:textColor="@color/bw_soft"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_cycle_left"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_cycle_bg"
            android:contentDescription="@string/widget_prev"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_left" />

        <ImageButton
            android:id="@+id/widget_cycle_right"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_cycle_bg"
            android:contentDescription="@string/widget_next"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_right" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_graph_list_wrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:visibility="gone">

        <ListView
            android:id="@+id/widget_graph_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:fadingEdgeLength="16dp"
            android:overScrollMode="never"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="@color/bw_soft"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/widget_buy"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_buy_bg"
        android:includeFontPadding="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:maxLines="1"
        android:text="@string/widget_buy"
        android:textAllCaps="false"
        android:textColor="@color/bw_on_primary"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
